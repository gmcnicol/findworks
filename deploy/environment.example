# Identifiers must differ between staging and production. Values here are names, never secrets.
FINDWORKS_ENVIRONMENT=staging
FINDWORKS_DATABASE_ID=findworks-staging-eu
FINDWORKS_PROVIDER_ACCOUNT_ID=findworks-staging-synthetic
PUBLIC_ORIGIN=https://staging.example.invalid
DATABASE_URL=jdbc:postgresql://database.example.invalid/findworks_staging?sslmode=verify-full
FINDWORKS_IMAGE=registry.example.invalid/findworks@sha256:REPLACE_WITH_64_HEX
PI_RUNTIME_IMAGE=registry.example.invalid/findworks-pi@sha256:REPLACE_WITH_64_HEX
INGRESS_IMAGE=caddy@sha256:REPLACE_WITH_64_HEX
EGRESS_PROXY_IMAGE=reviewed-proxy@sha256:REPLACE_WITH_64_HEX
