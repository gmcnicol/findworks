FINDWORKS_DOMAIN=findworks.example.com
FINDWORKS_APP_IMAGE=registry.example.com/findworks@sha256:REPLACE
FINDWORKS_WORKER_IMAGE=registry.example.com/findworks-worker@sha256:REPLACE
FINDWORKS_RUNTIME_IMAGE=registry.example.com/findworks-runtime@sha256:REPLACE
FINDWORKS_WEB_DATABASE_URL=jdbc:postgresql://managed-postgres.example.com:5432/findworks
FINDWORKS_WEB_DATABASE_USERNAME=findworks_web
FINDWORKS_WEB_DATABASE_PASSWORD=REPLACE
FINDWORKS_WORKER_DATABASE_URL=jdbc:postgresql://managed-postgres.example.com:5432/findworks
FINDWORKS_WORKER_DATABASE_USERNAME=findworks_worker
FINDWORKS_WORKER_DATABASE_PASSWORD=REPLACE
FINDWORKS_OPERATOR_TOKEN=REPLACE
FINDWORKS_OUTBOX_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
FINDWORKS_EMAIL_ENDPOINT=https://email-provider.example.com/send
FINDWORKS_EMAIL_API_KEY=REPLACE
FINDWORKS_EMAIL_FROM=FindWorks <interviews@example.com>
FINDWORKS_ROOTLESS_DOCKER_SOCKET=/run/user/10001/docker.sock
OPENAI_API_KEY=REPLACE
FINDWORKS_MODEL=REPLACE_WITH_PINNED_MODEL
