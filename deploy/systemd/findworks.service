[Unit]
Description=FindWorks M0 web, worker, and proxies
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/findworks-deploy
EnvironmentFile=%h/.config/findworks/production.env
ExecStart=/usr/bin/podman compose -f deploy/compose.yaml up -d --no-build --wait web worker egress ingress
ExecStop=/usr/bin/podman compose -f deploy/compose.yaml stop ingress web worker egress
TimeoutStartSec=180
TimeoutStopSec=180

[Install]
WantedBy=default.target
