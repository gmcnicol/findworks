DATABASE_URL=jdbc:postgresql://localhost:5432/findworks
DATABASE_USERNAME=findworks
DATABASE_PASSWORD=findworks
INVESTIGATOR_EMAIL=investigator@findworks.local
INVESTIGATOR_PASSWORD=findworks
PI_EXECUTABLE=pi
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.6-luna
PI_SESSION_DIRECTORY=/tmp/findworks-pi-sessions
INTERVIEW_RUNTIME_ENABLED=false
OCI_EXECUTABLE=podman
PI_RUNTIME_IMAGE=findworks/pi@sha256:replace-with-built-image-digest
PI_RUNTIME_NETWORK=none
PI_RUNTIME_EGRESS_PROXY=
PI_RUNTIME_USER=10001:10001
PI_RUNTIME_MEMORY=512m
PI_RUNTIME_CPUS=1.0
PI_RUNTIME_PIDS=64
PI_RUNTIME_NOFILE=256
PI_RUNTIME_TMPFS=32m
PI_RUNTIME_TIMEOUT=PT90S
MODEL_PROVIDER_CREDENTIAL=
RUNTIME_CHECKPOINT_KEY_ID=
RUNTIME_CHECKPOINT_KEY=
PUBLIC_ORIGIN=https://findworks.example
INVITATION_SENDER=interviews@findworks.example
INVITATION_TOKEN_KEY_ID=replace-with-active-key-id
INVITATION_TOKEN_SECRET=replace-with-at-least-32-random-characters
INVITATION_PREVIOUS_TOKEN_KEY_ID=
INVITATION_PREVIOUS_TOKEN_SECRET=
INTERVIEW_CONTACT=investigator@example.com
